# Server Environment Variables
# Copy this to .env and fill in your values

# PostgreSQL connection string (docker-compose defaults)
DATABASE_URL=postgresql://notes:notes_dev_password@localhost:5434/notes

# Redis (used by Phase 3 queues/caching)
REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 — Client ID for verifying Google ID tokens
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API (fallback provider)
OPENAI_API_KEY=your-openai-api-key-here

# Groq API (default provider)
GROQ_API_KEY=your-groq-api-key-here

# DeepSeek / Mistral / Anthropic (optional BYO-key providers for the free tier)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# AICredits — OpenAI-compatible gateway (default fallback for openai/groq/deepseek/mistral when no user/env key is set)
AICREDITS_BASE_URL=https://aicredits.in/v1
AICREDITS_API_KEY=your-aicredits-api-key-here
# Model ID as exposed by the AICredits gateway (must be a model that routes, e.g. "openai/gpt-4o-mini")
AICREDITS_MODEL=openai/gpt-4o-mini

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Server Port
PORT=5002