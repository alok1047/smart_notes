# Client Environment Variables
# Copy this to .env and fill in your Google OAuth config values

# Google OAuth 2.0 Client ID (from Google Cloud Console → Credentials → OAuth Client ID)
# Must match the "Authorized JavaScript origins" for your Vite dev server (http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# API Base URL — leave as /api for local dev (Vite proxy handles it)
# For production, set to your deployed server URL, e.g.:
# VITE_API_BASE_URL=https://smart-notes-server.onrender.com/api
VITE_API_BASE_URL=/api